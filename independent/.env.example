# Create a NEW Supabase project; apply independent/supabase/schema.sql only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY names are also accepted.

# Create this one user in Supabase Auth. There is no public sign-up endpoint.
OWNER_EMAIL=
APP_NAME=Cardputer Voice
# Local development: http://localhost:3000. Deployment: your HTTPS Vercel origin.
APP_ORIGIN=http://localhost:3000

# Use a Google AI Studio project on the Free tier, with billing NOT enabled.
# Keep this key in Vercel environment settings; never put it in firmware.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# App caps are additional limits, not a guarantee of Google's available quota.
# A crashed session consumes its full reserved time, so the budget fails closed.
DAILY_VOICE_SECONDS=600
SESSION_SECONDS=240
