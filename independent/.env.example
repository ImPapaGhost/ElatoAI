# SERVICE OPERATOR ONLY: ordinary Easy-setup users do not need this file.
# Apply BOTH independent/supabase/schema.sql and independent/supabase/byok.sql
# in your Supabase project. Do not apply the upstream ElatoAI demo migrations.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY names are also accepted.

# Create this one private-dashboard user in Supabase Auth; disable public signup.
# Easy BYOK guests enter their provider details on the Cardputer, not here.
OWNER_EMAIL=
APP_NAME=Cardputer Voice
# Local development: http://localhost:3000. Deployment: your HTTPS Vercel origin.
APP_ORIGIN=http://localhost:3000

# Private-owner Gemini credential. Guests never fall back to this key.
# To keep this owner's Google project on Free, leave billing disabled and
# verify model availability/quota in AI Studio. Provider limits can change.
# Keep this OPERATOR key in server environment settings, never in public firmware.
# Each Easy-setup guest instead stores their OWN chosen provider key on-device.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# Private-owner daily cap; this does not increase the shared BYOK allowance.
# These are additional service caps, not promised provider quota or free credits.
# A crashed session consumes its full reserved time, so the budget fails closed.
DAILY_VOICE_SECONDS=600
# Shared and private sessions are also bounded by this value (maximum 240).
SESSION_SECONDS=240

# Shared BYOK caps are fixed in src/byok-store.mjs and supabase/byok.sql:
# 600 seconds per provider key / UTC day, 1200 seconds total / UTC day,
# 100 accepted connection attempts / UTC day, 2 simultaneous sessions total,
# and at most 1 active session per provider key. No paid/provider fallback.
# Guest API keys are transient in the bridge and are never stored in Supabase.
# The database stores only key fingerprints, usage counters, and session leases.
